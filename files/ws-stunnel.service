[Unit]
Description=SATSET SSH WebSocket Tunnel Proxy (ws-stunnel)
After=network.target dropbear.service ssh.service
Wants=dropbear.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/ws-stunnel
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
