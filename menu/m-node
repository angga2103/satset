        echo -e "${ungu}[${BIWhite}01${ungu}] ${NC}${Lime}Hubungkan VPS Cabang Baru (Input Token)${NC}"
        echo -e "${ungu}[${BIWhite}02${ungu}] ${NC}${BIWhite}Lihat Daftar & Status Detail Node Cabang${NC}"
        echo -e "${ungu}[${BIWhite}03${ungu}] ${NC}${BIWhite}Remote Control Node Cabang (Restart/RAM)${NC}"
        echo -e "${ungu}[${BIWhite}04${ungu}] ${NC}${RED}Putuskan / Hapus VPS Cabang dari Cluster${NC}"
        echo -e "${ungu}[${BIWhite}05${ungu}] ${NC}${BIWhite}Tampilkan Token & API Key VPS Ini${NC}"
