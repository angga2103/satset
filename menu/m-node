"
                echo ""
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                read -rp "Tekan [Enter] untuk kembali..."
                ;;
            3|03)
                clear
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "${Lime}     REMOTE CONTROL SERVICE NODE CABANG   ${NC}"
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                python3 -c "
