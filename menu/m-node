        if [ "$NODE_COUNT" -gt 0 ]; then
            echo -e "${BIWhite}├──────────────────────────────────────────┤${NC}"
            echo -e "${BIWhite}│${NC} ${Lime}DAFTAR VPS CABANG AKTIF:${NC}"
            python3 -c "
