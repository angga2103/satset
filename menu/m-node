        echo -e "${ungu}[${BIWhite}08${ungu}] ${NC}${BIWhite}Ubah Port satset-node (Default: 9090)${NC}"
        echo -e "${ungu}[${BIWhite}09${ungu}] ${NC}${BIWhite}Reset / Generate API Key Baru${NC}"
