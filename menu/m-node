            print(json.dumps({'ok': False, 'msg': res.get('message', 'Gagal'), 'node': {}}))
    except Exception as e2:
        print(json.dumps({'ok': False, 'msg': str(e2), 'node': {}}))
" 2>/dev/null)

                IS_OK=$(echo "$RES" | jq -r '.ok // false' 2>/dev/null || echo "false")
                MSG=$(echo "$RES" | jq -r '.msg // empty' 2>/dev/null || echo "Koneksi gagal")

                echo ""
                if [ "$IS_OK" = "true" ]; then
                    echo -e "${green}====================================================${NC}"
                    echo -e "${green}  🎉 SUKSES: VPS CABANG BERHASIL DIHUBUNGKAN!      ${NC}"
                    echo -e "${green}====================================================${NC}"
                    echo -e "Keterangan: ${BIWhite}${MSG}${NC}"
                    echo -e "Status    : ${Lime}Handshake Berhasil!${NC}"
