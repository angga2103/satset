                fi
                echo ""
                read -rp "Tekan [Enter] untuk kembali..."
                ;;
            2|02)
                clear
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "${Lime}     DAFTAR LENGKAP & STATUS NODE CABANG  ${NC}"
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                python3 -c "
