                echo -ne "${CYAN}Pilih nomor server cabang: ${NC}"
                read -r srv_idx
                if [[ "$srv_idx" =~ ^[0-9]+$ ]] && [ "$srv_idx" -gt 0 ]; then
                    echo ""
