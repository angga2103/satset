        read -r opt

        case "$opt" in
            1|01)
                clear
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "${Lime}     HUBUNGKAN VPS CABANG KE MASTER       ${NC}"
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "Silakan paste Connection Token dari VPS Cabang:"
                echo -e "${BIYellow}(Contoh: satset-node://128.199.x.x:9090#key=xxx)${NC}"
                echo ""
                echo -ne "${CYAN}Token Cabang : ${NC}"
                read -r IN_TOKEN
                if [ -z "$IN_TOKEN" ]; then
                    echo -e "${RED}Token tidak boleh kosong!${NC}"
                    sleep 1
                    continue
                fi

                echo ""
                echo -e "⏳ Menguji koneksi & melakukan handshake dua arah..."
                RES=$(python3 -c "
