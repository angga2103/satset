#!/bin/bash
# =========================================================
# SATSET Multi-Node / VPS Cluster Manager
# Role Mutex, Bidirectional Handshake, and Cluster Control
# =========================================================
clear

RED='\033[0;31m'
NC='\033[0m'
green='\033[0;32m'
BIYellow='\033[1;93m'
BIWhite='\033[1;97m'
Lime='\e[38;5;155m'
ungu="\e[38;5;99m"
CYAN="\033[1;36m"

KEY_FILE="/etc/satset/node-key.txt"
CONF_FILE="/etc/satset/node.conf"
CLUSTER_FILE="/etc/satset/cluster.json"
NODE_BIN="/usr/local/bin/satset-node"

get_domain() {
    if [ -f /etc/xray/domain ]; then
        head -n 1 /etc/xray/domain | tr -d '[:space:]'
    elif [ -f /etc/xray/ipvps ]; then
        head -n 1 /etc/xray/ipvps | tr -d '[:space:]'
    else
        curl -4 -s --max-time 3 ipv4.icanhazip.com 2>/dev/null || echo "127.0.0.1"
    fi
}

get_port() {
    if [ -f "$CONF_FILE" ]; then
        grep -E "^PORT=" "$CONF_FILE" | cut -d'=' -f2 | tr -d '[:space:]'
    else
        echo "9090"
    fi
}

get_key() {
    if [ -f "$KEY_FILE" ]; then
        cat "$KEY_FILE" | tr -d '[:space:]'
    else
        echo ""
    fi
}

get_role() {
    if [ -f "$CLUSTER_FILE" ]; then
        python3 -c "import json; print(json.load(open('$CLUSTER_FILE')).get('role', 'standalone'))" 2>/dev/null || echo "standalone"
    else
        echo "standalone"
    fi
}

get_master_info() {
    if [ -f "$CLUSTER_FILE" ]; then
        python3 -c "import json; m = json.load(open('$CLUSTER_FILE')).get('master', {}); print(f\"{m.get('domain', m.get('host', '-'))}|{m.get('host', '-')}|{m.get('registered_at', '-')}\")" 2>/dev/null || echo "-|-|-|"
    else
        echo "-|-|-|"
    fi
}

count_nodes() {
    if [ -f "$CLUSTER_FILE" ]; then
        python3 -c "import json; print(len(json.load(open('$CLUSTER_FILE')).get('nodes', [])))" 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}

while true; do
    clear
    HOST=$(get_domain)
    PORT=$(get_port)
    PORT=${PORT:-9090}
    KEY=$(get_key)
    ROLE=$(get_role)
    SVC_STATUS=$(systemctl is-active satset-node 2>/dev/null || echo "inactive")

    if [ "$SVC_STATUS" = "active" ]; then
        STATUS_BADGE="${green}ACTIVE (Port ${PORT})${NC}"
    else
        STATUS_BADGE="${RED}INACTIVE (Stopped)${NC}"
    fi

    TOKEN="satset-node://${HOST}:${PORT}#key=${KEY}"

    echo -e "${BIWhite}┌──────────────────────────────────────────┐${NC}"
    echo -e "${BIWhite}│${NC}   ${Lime}SATSET MULTI-VPS CLUSTER MANAGER${NC}       ${BIWhite}│${NC}"
    echo -e "${BIWhite}├──────────────────────────────────────────┤${NC}"
    echo -e "${BIWhite}│${NC} Status Agent : ${STATUS_BADGE}"
    echo -e "${BIWhite}│${NC} Host VPS     : ${CYAN}${HOST}${NC}"

    if [ "$ROLE" = "node" ]; then
        IFS='|' read -r M_DOM M_HOST M_TIME <<< "$(get_master_info)"
        echo -e "${BIWhite}│${NC} Peran Sistem : ${CYAN}🌐 VPS CABANG (WORKER NODE)${NC}"
        echo -e "${BIWhite}│${NC} Induk Master : ${Lime}👑 ${M_DOM}${NC} (${M_HOST})"
        echo -e "${BIWhite}│${NC} Status Master: ${green}🟢 TERKONEKSI KE MASTER${NC}"
        echo -e "${BIWhite}├──────────────────────────────────────────┤${NC}"
        echo -e "${BIWhite}│${NC} ${BIYellow}⚠️  PERINGATAN ROLE MUTEX:${NC}"
        echo -e "${BIWhite}│${NC} VPS ini adalah ${CYAN}VPS CABANG${NC}. Fitur input API"
        echo -e "${BIWhite}│${NC} key cabang lain ${RED}DIKUNCI${NC} (hanya Master)."
        echo -e "${BIWhite}├──────────────────────────────────────────┤${NC}"
        echo -e "${ungu}[${BIWhite}01${ungu}] ${NC}${BIWhite}Cek Status Koneksi ke Master VPS (Ping)${NC}"
        echo -e "${ungu}[${BIWhite}02${ungu}] ${NC}${BIWhite}Tampilkan Token & API Key VPS Ini${NC}"
        echo -e "${ungu}[${BIWhite}03${ungu}] ${NC}${RED}Putuskan Hubungan dari Master (Reset)${NC}"
        echo -e "${ungu}[${BIWhite}04${ungu}] ${NC}${BIWhite}Cek Live Log Service satset-node${NC}"
        echo -e "${ungu}[${BIWhite}05${ungu}] ${NC}${BIWhite}Restart Service satset-node${NC}"
        echo -e "${ungu}[${BIWhite}06${ungu}] ${NC}${BIWhite}Ubah Port satset-node (Default: 9090)${NC}"
        echo -e "${ungu}[${BIWhite}00${ungu}] ${NC}${BIWhite}Kembali ke Menu Utama${NC}"
        echo -e "${BIWhite}└──────────────────────────────────────────┘${NC}"
        echo -ne "${CYAN}Pilih opsi [00-06]: ${NC}"
        read -r opt

        case "$opt" in
            1|01)
                clear
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "${Lime}     UJI KONEKSI KE VPS MASTER            ${NC}"
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "Master Domain : ${CYAN}${M_DOM}${NC}"
                echo -e "Master IP     : ${CYAN}${M_HOST}${NC}"
                echo -e "Sedang menguji konektivitas..."
                echo ""
                python3 -c "
import socket, time
host = '$M_HOST'
t0 = time.time()
connected = False
for p in [80, 443, 22]:
    try:
        s = socket.create_connection((host, p), timeout=3.0)
        s.close()
        connected = True
        break
    except Exception:
        pass
elapsed = int((time.time() - t0) * 1000)
if connected:
    print(f'\033[1;92m[✓] STATUS: 🟢 ONLINE (Terhubung dalam {elapsed} ms)\033[0m')
    print('VPS Cabang ini aktif dan tersinkronisasi dengan Master!')
else:
    print('\033[0;31m[x] STATUS: 🔴 OFFLINE / TIMEOUT\033[0m')
    print('Gagal menjangkau VPS Master pada port umum.')
"
                echo ""
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                read -rp "Tekan [Enter] untuk kembali..."
                ;;
            2|02)
                clear
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "${Lime}        TOKEN KONEKSI VPS INI             ${NC}"
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "Token ini adalah kredensial resmi VPS ini:"
                echo ""
                echo -e "${BIYellow}${TOKEN}${NC}"
                echo ""
                echo -e "API Key: ${CYAN}${KEY}${NC}"
                echo -e "Port   : ${CYAN}${PORT}${NC}"
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                read -rp "Tekan [Enter] untuk kembali..."
                ;;
            3|03)
                clear
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "${RED}       PUTUSKAN HUBUNGAN DARI MASTER       ${NC}"
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                echo -e "Apakah Anda yakin ingin memutuskan VPS ini dari"
                echo -e "Master: ${CYAN}${M_DOM}${NC} ?"
                echo ""
                echo -e "Setelah diputuskan, status VPS ini akan kembali"
                echo -e "menjadi ${BIYellow}STANDALONE${NC} dan bebas terhubung ke Master lain."
                echo ""
                echo -ne "${BIYellow}Ketik 'PUTUS' untuk konfirmasi: ${NC}"
                read -r conf
                if [ "$conf" = "PUTUS" ]; then
                    python3 -c "
from satset_node import unregister_as_node
ok, msg = unregister_as_node()
print(msg)
" 2>/dev/null || {
                        python3 -c "import json; json.dump({'role': 'standalone', 'master': {}, 'nodes': []}, open('$CLUSTER_FILE', 'w'), indent=2)" 2>/dev/null
                        echo "Status VPS berhasil di-reset ke Standalone."
                    }
                    sleep 2
                else
                    echo -e "${RED}Dibatalkan.${NC}"
                    sleep 1
                fi
                ;;
            4|04)
                clear
                echo -e "${Lime}Live Log satset-node (Tekan Ctrl+C untuk keluar):${NC}"
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                journalctl -u satset-node -n 40 --no-pager
                echo -e "${BIWhite}──────────────────────────────────────────${NC}"
                read -rp "Tekan [Enter] untuk kembali..."
                ;;
            5|05)
                systemctl restart satset-node
                echo -e "${green}Service satset-node berhasil direstart.${NC}"
                sleep 1
                ;;
            6|06)
                clear
                echo -ne "${CYAN}Masukkan Port Baru [1024-65535] (Saat ini: ${PORT}): ${NC}"
                read -r NEW_PORT
                if [[ "$NEW_PORT" =~ ^[0-9]+$ ]] && [ "$NEW_PORT" -ge 1024 ] && [ "$NEW_PORT" -le 65535 ]; then
                    echo "PORT=${NEW_PORT}" > "$CONF_FILE"
                    systemctl restart satset-node
                    echo -e "${green}Port berhasil diubah ke ${NEW_PORT}!${NC}"
                else
                    echo -e "${RED}Port tidak valid!${NC}"
                fi
                sleep 2
                ;;
            0|00)
                exit 0
                ;;
            *)
                echo -e "${RED}Pilihan tidak valid!${NC}"
                sleep 1
                ;;
        esac

    else
        # Role is MASTER or STANDALONE
        NODE_COUNT=$(count_nodes)
        if [ "$ROLE" = "master" ]; then
            ROLE_BADGE="${green}👑 VPS MASTER (SERVER PUSAT)${NC}"
        else
            ROLE_BADGE="${BIYellow}⚪ STANDALONE (Bisa Jadi Master/Cabang)${NC}"
        fi

