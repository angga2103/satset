                if [ "$conf" = "RESET" ]; then
                    python3 "$NODE_BIN" reset-key
                    sleep 2
                else
                    echo -e "${RED}Dibatalkan.${NC}"
                    sleep 1
                fi
                ;;
            0|00)
                exit 0
                ;;
            *)
                echo -e "${RED}Pilihan tidak valid!${NC}"
                sleep 1
                ;;
        esac
    fi
done
