#!/bin/bash
clear
y='\033[1;33m'
BGX="\033[42m"
CYAN="\033[96m"
Putih="\033[97m"
RED='\033[0;31m'
NC='\033[0m'
green='\033[0;32m'
Lime='\e[38;5;155m'
BIWhite='\033[1;97m'
bggreen='\e[42;97;1m'

echo -e "${BIWhite}──────────────────────────────────────────${NC}"
echo -e "${bggreen}             UPDATE SCRIPT                ${NC}"
echo -e "${BIWhite}──────────────────────────────────────────${NC}"
echo ""

REPO="https://raw.githubusercontent.com/angga2103/satset/main"
CACHE_BUSTER="?v=$(date +%s)"

echo -e "${y}[1/3] Mengunduh & memperbarui CLI menu...${NC}"
TMP_DIR=$(mktemp -d)
wget -q -O "${TMP_DIR}/menu.zip" "${REPO}/menu/menu.zip${CACHE_BUSTER}" 2>/dev/null || \
curl -fsSL -o "${TMP_DIR}/menu.zip" "${REPO}/menu/menu.zip${CACHE_BUSTER}" 2>/dev/null || true

if [ -f "${TMP_DIR}/menu.zip" ]; then
    unzip -o -q "${TMP_DIR}/menu.zip" -d "${TMP_DIR}"
    if [ -d "${TMP_DIR}/menu" ]; then
        sed -i 's/\r$//' "${TMP_DIR}/menu"/* 2>/dev/null || true
        chmod +x "${TMP_DIR}/menu"/*
        mv -f "${TMP_DIR}/menu"/* /usr/local/sbin/
        echo -e "${green}✓ CLI menu berhasil diperbarui.${NC}"
    else
        sed -i 's/\r$//' "${TMP_DIR}"/* 2>/dev/null || true
        chmod +x "${TMP_DIR}"/* 2>/dev/null || true
        mv -f "${TMP_DIR}"/* /usr/local/sbin/ 2>/dev/null || true
        echo -e "${green}✓ CLI menu berhasil diperbarui.${NC}"
    fi
fi
rm -rf "${TMP_DIR}"

# Pastikan bot-store terbaru terpasang di /usr/local/sbin
wget -q -O /usr/local/sbin/bot-store "${REPO}/menu/bot-store${CACHE_BUSTER}" 2>/dev/null || \
curl -fsSL -o /usr/local/sbin/bot-store "${REPO}/menu/bot-store${CACHE_BUSTER}" 2>/dev/null || true
chmod +x /usr/local/sbin/bot-store 2>/dev/null || true

echo -e "${y}[2/3] Memperbarui modul Bot Store & PAYG...${NC}"
mkdir -p /etc/satset/bot-store
BOT_FILES=(
    "config.py"
    "database.py"
    "pakasir.py"
    "xray_manager.py"
    "payg_worker.py"
    "bot.py"
    "requirements.txt"
    "satset-bot.service"
    "install_store.sh"
    "xray_patcher.py"
)
for f in "${BOT_FILES[@]}"; do
    wget -q -O "/etc/satset/bot-store/$f" "${REPO}/bot-store/$f${CACHE_BUSTER}" 2>/dev/null || \
    curl -fsSL -o "/etc/satset/bot-store/$f" "${REPO}/bot-store/$f${CACHE_BUSTER}" 2>/dev/null || true
done
chmod +x /etc/satset/bot-store/install_store.sh 2>/dev/null || true
chmod +x /etc/satset/bot-store/xray_patcher.py 2>/dev/null || true

# Update python dependencies jika venv tersedia
if [ -x /etc/satset/venv/bin/pip ]; then
    /etc/satset/venv/bin/pip install -q -r /etc/satset/bot-store/requirements.txt 2>/dev/null || true
fi

# Pulihkan & Validasi Domain jika korup
if [ -f /etc/xray/domain ]; then
    CURR_DOMAIN=$(head -n1 /etc/xray/domain 2>/dev/null | tr -d ' \t\r\n' || true)
    if [[ ! "$CURR_DOMAIN" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
        echo -e "${y}• Mendeteksi format domain korup. Memulihkan dari sertifikat SSL...${NC}"
        REC_DOMAIN=$(openssl x509 -in /etc/xray/xray.crt -noout -subject 2>/dev/null | grep -oP 'CN\s*=\s*\K[^\s,]+' | grep -v 'localhost' | head -n1 || true)
        if [[ ! "$REC_DOMAIN" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]] && [ -d /root/.acme.sh ]; then
            REC_DOMAIN=$(find /root/.acme.sh -maxdepth 1 -name "*.*" -type d 2>/dev/null | head -n1 | sed 's/.*\///; s/_ecc$//' || true)
        fi
        if [[ "$REC_DOMAIN" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
            echo "$REC_DOMAIN" > /etc/xray/domain
            echo "$REC_DOMAIN" > /root/domain
            echo -e "${green}✓ Domain berhasil dipulihkan: $REC_DOMAIN${NC}"
        fi
    fi
fi

# Terapkan Anti-Adblock & Anti-Torrent ke konfigurasi Xray yang ada
if [ -f /etc/xray/config.json ]; then
    echo -e "${y}• Memperbarui aturan Anti-Adblock & Anti-Torrent Xray...${NC}"
    if [ -x /etc/satset/venv/bin/python3 ]; then
        /etc/satset/venv/bin/python3 /etc/satset/bot-store/xray_patcher.py /etc/xray/config.json 2>/dev/null || true
    elif command -v python3 >/dev/null 2>&1; then
        python3 /etc/satset/bot-store/xray_patcher.py /etc/xray/config.json 2>/dev/null || true
    fi
fi

# Pasang & Terapkan TCP BBR Speed Booster & Proteksi Anti-DDoS
echo -e "${y}• Memasang kernel tune TCP BBR & Firewall Anti-DDoS...${NC}"
mkdir -p /etc/satset
wget -q -O /usr/local/sbin/tune-network "${REPO}/files/tune-network.sh${CACHE_BUSTER}" 2>/dev/null || \
curl -fsSL -o /usr/local/sbin/tune-network "${REPO}/files/tune-network.sh${CACHE_BUSTER}" 2>/dev/null || true
chmod +x /usr/local/sbin/tune-network 2>/dev/null || true
cp -f /usr/local/sbin/tune-network /etc/satset/tune-network.sh 2>/dev/null || true
ln -sf /usr/local/sbin/tune-network /usr/local/sbin/bbr 2>/dev/null || true
/usr/local/sbin/tune-network apply >/dev/null 2>&1 || true

# Pasang & Aktifkan BadVPN UDPGW Multi-Port (7100, 7200, 7300)
echo -e "${y}• Memasang & mengaktifkan BadVPN UDPGW (Gaming 7100, 7200, 7300)...${NC}"
wget -q -O /tmp/install-badvpn.sh "${REPO}/files/install-badvpn.sh${CACHE_BUSTER}" 2>/dev/null || \
curl -fsSL -o /tmp/install-badvpn.sh "${REPO}/files/install-badvpn.sh${CACHE_BUSTER}" 2>/dev/null || true
if [ -s /tmp/install-badvpn.sh ]; then
    chmod +x /tmp/install-badvpn.sh 2>/dev/null || true
    bash /tmp/install-badvpn.sh || true
    rm -f /tmp/install-badvpn.sh
    echo -e "${green}✓ BadVPN UDPGW Gaming (7100, 7200, 7300) siap digunakan.${NC}"
fi

# Cache data jaringan VPS untuk mempercepat transisi respon CLI menu
mkdir -p /etc/xray
if [ ! -s /etc/xray/ipvps ] || grep -q ":" /etc/xray/ipvps 2>/dev/null; then
    curr_ip=$(curl -4 -s --max-time 3 ipv4.icanhazip.com 2>/dev/null || curl -4 -s --max-time 3 ifconfig.me 2>/dev/null || curl -4 -s --max-time 3 ipinfo.io/ip 2>/dev/null || echo "")
    if [[ "$curr_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$curr_ip" > /etc/xray/ipvps 2>/dev/null || true
        echo "$curr_ip" > /root/ipvps 2>/dev/null || true
        echo "IP=$curr_ip" > /var/lib/ipvps.conf 2>/dev/null || true
    fi
fi
if [ ! -s /etc/xray/isp ] || [ ! -s /etc/xray/city ]; then
    resp=$(curl -s --max-time 2 "http://ip-api.com/json/?fields=country,city,isp" 2>/dev/null || true)
    isp_val=$(echo "$resp" | jq -r '.isp // empty' 2>/dev/null || true)
    city_val=$(echo "$resp" | jq -r '.city // empty' 2>/dev/null || true)
    country_val=$(echo "$resp" | jq -r '.country // empty' 2>/dev/null || true)
    [ -n "$isp_val" ] && echo "$isp_val" > /etc/xray/isp 2>/dev/null || true
    if [ -n "$city_val" ]; then
        [ -n "$country_val" ] && echo "$city_val, $country_val" > /etc/xray/city 2>/dev/null || echo "$city_val" > /etc/xray/city 2>/dev/null
    fi
fi

echo -e "${green}✓ Berkas Bot Store & Optimasi Jaringan berhasil diperbarui.${NC}"

echo -e "${y}[3/3] Memeriksa status service bot...${NC}"
if systemctl is-active --quiet satset-bot 2>/dev/null; then
    systemctl restart satset-bot 2>/dev/null || true
    sleep 2
    if systemctl is-active --quiet satset-bot 2>/dev/null; then
        echo -e "${green}✓ Service satset-bot berhasil direstart (Running).${NC}"
    else
        echo -e "${RED}⚠ Service satset-bot gagal aktif setelah restart! Cek log: journalctl -u satset-bot -n 25${NC}"
    fi
else
    echo -e "${CYAN}• Service satset-bot dalam status non-aktif (Jalankan 'install-store' atau 'm-bot' untuk mengaktifkan).${NC}"
fi

echo ""
echo -e "${BIWhite}──────────────────────────────────────────${NC}"
echo -e "${green}      UPDATE SCRIPT SELESAI DENGAN SUKSES!${NC}"
echo -e "${BIWhite}──────────────────────────────────────────${NC}"
echo ""
if [ -t 0 ]; then
    read -n 1 -s -r -p "Tekan [ Enter ] untuk kembali ke menu..."
    echo ""
    menu 2>/dev/null || true
else
    echo -e "${green}Update selesai! Ketik '${CYAN}menu${green}' untuk membuka menu utama VPS.${NC}"
fi
